<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" role="img" aria-label="Flowfin">
  <title>Flowfin</title>
  <style>
    .ground { fill: #FAFAFA }
    .ink { fill: #0E0E11 }
    @media (prefers-color-scheme: dark) {
      .ground { fill: #121216 }
      .ink { fill: #ECECEF }
    }
  </style>
  <rect class="ground" width="64" height="64" rx="12" />
  <text class="ink" x="32" y="32" text-anchor="middle" dominant-baseline="central" font-family="ui-sans-serif, -apple-system, 'Segoe UI', Roboto, system-ui, sans-serif" font-size="42" font-weight="700">F</text>
</svg>
