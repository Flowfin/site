<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{{ .Title }}</title>
    <meta name="description" content="{{ .Description }}" />
    <link rel="canonical" href="{{ .Canonical }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ .SiteName }}" />
    <meta property="og:title" content="{{ .Title }}" />
    <meta property="og:description" content="{{ .Description }}" />
    <meta property="og:url" content="{{ .Canonical }}" />
  </head>
  <body>
    <a href="#content">Skip to the content</a>
    <main id="content" tabindex="-1">
      <h1>{{ .Title }}</h1>
      {{- range .Paragraphs }}
      <p>{{ . }}</p>
      {{- end }}
      {{- if .Plugins }}
      <h2>The plugins, and what state each one is in</h2>
      <p>{{ .PluginsRead }}</p>
      <table>
        <tr>
          <th>Plugin</th>
          <th>What it does</th>
          <th>State</th>
        </tr>
        {{- range .Plugins }}
        <tr>
          <td><a href="{{ .Href }}">{{ .ID }}</a></td>
          <td>{{ .Summary }}</td>
          <td>{{ .State }}</td>
        </tr>
        {{- end }}
      </table>
      {{- end }}
      {{- if .InstallableRead }}
      <h2>What can be installed today</h2>
      <p>{{ .InstallableRead }}</p>
      {{- if .Installable }}
      <ul>
        {{- range .Installable }}
        <li><a href="{{ .Href }}">{{ .ID }}</a> {{ .Summary }}{{ if .Targets }} Published for {{ .Targets }}.{{ end }}</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- end }}
      {{- if .Onward }}
      <nav aria-label="Where to go from here">
        <ul>
          {{- range .Onward }}
          <li><a href="{{ .Href }}">{{ .Text }}</a></li>
          {{- end }}
        </ul>
      </nav>
      {{- end }}
      {{- if .Notices }}
      <dl>
        {{- range .Notices }}
        <dt>{{ .Asks }}</dt>
        {{- if .Answer }}
        <dd>{{ .Answer }}</dd>
        {{- else }}
        <dd>
          Not decided yet. {{ .Waiting }} is where that answer is taken, and this
          line says so rather than standing empty.
        </dd>
        {{- end }}
        {{- end }}
      </dl>
      {{- end }}
      {{- if .Claims }}
      <h2>What is checked, and by what</h2>
      <ul>
        {{- range .Claims }}
        <li data-refused-by="{{ .RefusedBy }}">
          {{ .Text }} Refused by <code>{{ .RefusedBy }}</code>.
        </li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Promises }}
      <h2>What is promised and not yet checked</h2>
      <ul>
        {{- range .Promises }}
        <li>{{ .Text }} Nothing refuses this yet, and {{ .Waiting }} is where the check that would is held.</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Residuals }}
      <h2>What this page does not claim</h2>
      {{- range .Residuals }}
      <p>{{ . }}</p>
      {{- end }}
      {{- end }}
      {{/* Every drawing below writes its property here and hands the engine a
      value, so each one is read in a value position and filtered rather than
      being assembled into markup somewhere else and written out unread. The
      weight is stated in words rather than drawn, because the property that
      would draw it may not appear in what the build reads. */}}
      {{- if .TypeScale }}
      <h2>Type, at both viewing distances</h2>
      <p>
        Each role drawn at the size the file gives it, with its weight beside it.
        The two distances are one scale read from two distances rather than two
        scales.
      </p>
      <ul>
        {{- range .TypeScale }}
        <li><span style="font-size:{{ .Size }}px">{{ .Role }}</span> {{ .Distance }}, {{ .Size }} at weight {{ .Weight }}</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Corners }}
      <h2>The corner a tile is drawn with</h2>
      <p>
        Each radius drawn as the corner it makes. The surface and the ink are the
        light scheme's, so the corner is visible against the box rather than
        against the page.
      </p>
      <ul>
        {{- range .Corners }}
        <li><span style="border-radius:{{ .Radius }}px;background:{{ .Ground }};color:{{ .Ink }}">{{ .Name }}</span> {{ .Radius }}</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Rings }}
      <h2>The focus ring, one per colour vision preset</h2>
      <p>
        Each preset's accent drawn as the ring it makes, at the width that preset
        asks for, in both schemes. What each preset is for is what a reader is
        missing.
      </p>
      <ul>
        {{- range .Rings }}
        <li><span style="outline:{{ .Width }}px solid {{ .Accent }}">{{ .Preset }}</span> {{ .Scheme }}, missing {{ .Missing }}</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- range .Budgets }}
      <h2>{{ .Whose }}</h2>
      <p>{{ .Says }}</p>
      <table>
        <tr>
          <th>Line</th>
          <th>Limit</th>
          <th>What it measures</th>
        </tr>
        {{- range .Rows }}
        <tr>
          <td>{{ .Name }}</td>
          <td>{{ .Limit }}</td>
          <td>{{ .Means }}</td>
        </tr>
        {{- end }}
      </table>
      {{- end }}
      {{- if .Values }}
      <h2>Every value the file carries</h2>
      <p>{{ .Reading }}</p>
      {{/* One line per value, and the indentation a reader of this template
      expects is deliberately not written into the output: at this many values
      it is a tenth of the document, against a budget the whole page is close
      to, and nothing reads this list but a browser. It is a template comment
      rather than a markup one so that the explanation costs the reader of the
      page nothing. */}}
      <dl>
        {{- range .Values }}
<dt>{{ .Path }}</dt><dd>{{ .Value }}{{ if .Colour }} <span style="background:{{ .Colour }};color:{{ .Colour }}">{{ .Value }}</span>{{ end }}</dd>
        {{- end }}
      </dl>
      {{- end }}
    </main>
    <footer>
      <p>
        Flowfin is not affiliated with the Jellyfin project. Other projects are
        named here to say what this software works with, and nothing further is
        meant by naming them.
      </p>
      <p>
        <a href="/legal/">Who publishes this site</a>
      </p>
      <p>
        <a href="https://github.com/Flowfin/site/blob/main/NOTICE.md"
          >The intended-use notice</a
        >
      </p>
    </footer>
  </body>
</html>
