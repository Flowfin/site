<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{{ .Title }}</title>
    <meta name="description" content="{{ .Description }}" />
    <link rel="canonical" href="{{ .Canonical }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ .SiteName }}" />
    <meta property="og:title" content="{{ .Title }}" />
    <meta property="og:description" content="{{ .Description }}" />
    <meta property="og:url" content="{{ .Canonical }}" />
  </head>
  <body>
    <a href="#content">Skip to the content</a>
    <main id="content" tabindex="-1">
      <h1>{{ .Title }}</h1>
      {{- range .Paragraphs }}
      <p>{{ . }}</p>
      {{- end }}
      {{- if .Onward }}
      <nav aria-label="Where to go from here">
        <ul>
          {{- range .Onward }}
          <li><a href="{{ .Href }}">{{ .Text }}</a></li>
          {{- end }}
        </ul>
      </nav>
      {{- end }}
      {{- if .Notices }}
      <dl>
        {{- range .Notices }}
        <dt>{{ .Asks }}</dt>
        {{- if .Answer }}
        <dd>{{ .Answer }}</dd>
        {{- else }}
        <dd>
          Not decided yet. {{ .Waiting }} is where that answer is taken, and this
          line says so rather than standing empty.
        </dd>
        {{- end }}
        {{- end }}
      </dl>
      {{- end }}
      {{- if .Claims }}
      <h2>What is checked, and by what</h2>
      <ul>
        {{- range .Claims }}
        <li data-refused-by="{{ .RefusedBy }}">
          {{ .Text }} Refused by <code>{{ .RefusedBy }}</code>.
        </li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Promises }}
      <h2>What is promised and not yet checked</h2>
      <ul>
        {{- range .Promises }}
        <li>{{ .Text }} Nothing refuses this yet, and {{ .Waiting }} is where the check that would is held.</li>
        {{- end }}
      </ul>
      {{- end }}
      {{- if .Residuals }}
      <h2>What this page does not claim</h2>
      {{- range .Residuals }}
      <p>{{ . }}</p>
      {{- end }}
      {{- end }}
    </main>
    <footer>
      <p>
        Flowfin is not affiliated with the Jellyfin project. Other projects are
        named here to say what this software works with, and nothing further is
        meant by naming them.
      </p>
      <p>
        <a href="/legal/">Who publishes this site</a>
      </p>
      <p>
        <a href="https://github.com/Flowfin/site/blob/main/NOTICE.md"
          >The intended-use notice</a
        >
      </p>
    </footer>
  </body>
</html>
